<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <include name="enterprise-analytics/base-manifest_lumina.xml"/>

  <!-- Pick up Analytics projects from master & phoenix branches -->
  <extend-project name="cbas-core" revision="lumina" dest-branch="lumina"/>
  <extend-project name="asterixdb" revision="lumina" dest-branch="lumina"/>
  <extend-project name="analytics-dcp-client" revision="lumina" dest-branch="lumina"/>
  <extend-project name="cbas" revision="lumina" dest-branch="lumina"/>
  <extend-project name="cbas-ui" revision="lumina" dest-branch="lumina"/>

  <!-- Add the columnar-ui project -->
  <project name="columnar-ui-v1" groups="notdefault,build,enterprise,analytics" revision="976967c347bb3e6116a85cc2d17487b5708e7db9"/>

  <!-- pick up latest product-texts so we have the most accurate README.txt & licenses -->
  <extend-project name="product-texts" revision="master"/>

  <!-- pick up latest product-metadata so we have the most accurate NOTICE.txt -->
  <extend-project name="product-metadata" revision="master"/>

  <!-- MB-74640: golang main moved SUPPORTED_NEWER to Go 1.27 (CBD-6921), whose json v2
       engine corrupts metakv entries handed out by the cbauth this product builds
       against.  Track supported-newer-1.26, as morpheus and helios do, until a cbauth
       carrying the MB-74640 fix reaches the base manifest. -->
  <extend-project name="golang" revision="supported-newer-1.26"/>

  <!-- advance select projects to enable Go & Python to be advanced ahead of 8.0.1 for CVEs -->
  <extend-project name="voltron" revision="9f4df742bb5451107ea04dfb44b391149a6994ed"/>
  <extend-project name="tlm" revision="854ec55e44f7d31a9d21d5bc7a98bed9d6827ccc"/>

  <!-- MB-71811: pick up ns_server fork w/ fix -->
  <extend-project name="ns_server" revision="lumina"/>

  <!-- Update build project to provide different annotations -->
  <remove-project name="build"/>
  <project name="build" path="cbbuild" revision="" upstream="master" dest-branch="master" groups="notdefault,build">
    <annotation name="VERSION" value="2.2.2" keep="true"/>
    <annotation name="SERVER_VERSION" value="8.0.2" keep="true"/>
    <annotation name="SERVER_BLD_NUM" value="8.0.2-5503" keep="true"/>
    <annotation name="SERVER_RELEASE" value="morpheus" keep="true"/>
    <annotation name="COLUMNAR" value="true" keep="true"/>
    <annotation name="COLUMNAR_COMPAT_VERSION" value="2.2.2"/>
    <annotation name="MIN_SUPPORTED_COLUMNAR_COMPAT_VERSION" value="2.0.0"/>
    <annotation name="MIN_SUPPORTED_COLUMNAR_PROVISIONED_COMPAT_VERSION" value="2.1.0"/>
  </project>

  <remove-project name="query"/>
  <remove-project name="query-ee"/>
  <remove-project name="indexing"/>
  <remove-project name="goxdcr"/>
  <remove-project name="xdcrDiffer"/>
  <remove-project name="gometa"/>
  <remove-project name="cbft"/>
  <remove-project name="cbftx"/>
  <remove-project name="cbgt"/>
  <remove-project name="hebrew"/>
  <remove-project name="eventing"/>
  <remove-project name="eventing-ee"/>
  <remove-project name="cbbs"/>
  <remove-project name="n1fty"/>
  <remove-project name="bhive"/>
  <remove-project name="plasma"/>
  <remove-project name="gocbcrypto"/>
  <!-- we can't remove the following at least while we have a test dependency on samples
  <remove- project name="magma"/>
  <remove- project name="backup"/>
 -->
  <remove-project name="udf-api"/>
  <remove-project name="godbc"/>
  <remove-project name="nitro"/>
  <remove-project name="regulator"/>
</manifest>
