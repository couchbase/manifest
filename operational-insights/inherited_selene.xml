<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- The Selene layer under operational-insights/selene.xml, sitting between
       it and the generated base manifest.  Forked from inherited_helios.xml so
       the two releases can diverge; keep it out of helios.xml.

       Anything declared here is inherited by selene.xml rather than declared
       in it, which is what takes it out of scope for the missing commits
       check: find_missing_commits reads only the <project> and
       <extend-project> elements a manifest names itself and deliberately does
       not follow <include>.  So this file is where a project whose divergence
       from Couchbase Server is intentional belongs - one we have taken
       ownership of and do not want merged forward. -->

  <include name="operational-insights/base-manifest_selene.xml"/>

  <!-- MB-72186, CBD-6820: Selene runs the operational-insights ns_server branch; Server's
       ns_server commits are not ours to merge forward. -->
  <extend-project name="ns_server" revision="724218693d18419b7a6f8d05b98d91e5200c1322" dest-branch="morpheus"/>

  <extend-project name="couchbase-cli" revision="385c95442597acb473a86d4f0ec1067d3667e974"/>

</manifest>
