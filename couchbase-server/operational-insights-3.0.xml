<!-- CBD-6820: A dummy manifest to enable ns_server CI on the operational-insights-3.0 branch -->
<manifest>
  <include name="operational-insights/helios.xml"/>

  <!-- ns_server CI is a Couchbase Server build, and does not sync the analytics
       projects: its jobs use restricted group sets rather than -g all.  So it
       must not build as columnar.  operational-insights/helios.xml re-adds the
       build project carrying COLUMNAR=true, which is what tlm reads to set
       BUILD_COLUMNAR, so put back the build block the helios base declares.
       BLD_NUM is deliberately omitted: it pins a single build in the base
       snapshot and means nothing here. -->
  <remove-project name="build"/>
  <project name="build" path="cbbuild" groups="notdefault,build">
    <annotation name="RELEASE" value="morpheus" />
    <annotation name="PRODUCT" value="couchbase-server" />
    <annotation name="VERSION" value="8.0.3" />
    <annotation name="BSL_PRODUCT" value="Couchbase Server" />
    <annotation name="BSL_VERSION" value="8.0" />
    <annotation name="BSL_CHANGE_DATE" value="March 1, 2029" />
    <annotation name="BSL_MAIN_OK" value="true" />
  </project>
</manifest>
